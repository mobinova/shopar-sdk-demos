<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>ShoparSDKSourceRevision</key><string>$(INFOPLIST_KEY_ShoparSDKSourceRevision)</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>MinimumOSVersion</key><string>$(IPHONEOS_DEPLOYMENT_TARGET)</string>
    <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
    <key>ShoparDemoAgencyAppID</key><string>$(SHOPAR_DEMO_AGENCY_APP_ID)</string>
    <key>ShoparDemoAgencyHost</key><string>$(SHOPAR_DEMO_AGENCY_HOST)</string>
    <key>ShoparDemoAgencyPort</key><string>$(SHOPAR_DEMO_AGENCY_PORT)</string>
    <key>ShoparDemoAgencyTLS</key><string>$(SHOPAR_DEMO_AGENCY_TLS)</string>
    <key>ShoparDemoDiscoveryAppID</key><string>$(SHOPAR_DEMO_DISCOVERY_APP_ID)</string>
    <key>ShoparDemoDiscoveryHost</key><string>$(SHOPAR_DEMO_DISCOVERY_HOST)</string>
    <key>ShoparDemoDiscoveryPort</key><string>$(SHOPAR_DEMO_DISCOVERY_PORT)</string>
    <key>ShoparDemoDiscoveryTLS</key><string>$(SHOPAR_DEMO_DISCOVERY_TLS)</string>
    <key>ShoparDemoDiscoveryPlacementIDs</key><string>$(SHOPAR_DEMO_DISCOVERY_PLACEMENT_IDS)</string>
    <key>ShoparDemoDiscoverySelectedPlacementID</key><string>$(SHOPAR_DEMO_DISCOVERY_SELECTED_PLACEMENT_ID)</string>
</dict>
</plist>
